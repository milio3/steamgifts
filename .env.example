PROJECT_NAME="SteamGifts Bot"
PORT=8086
DEBUG=false
DATABASE_URL="sqlite:////app/data/database.db"
STEAMGIFTS_PHPSESSID=""
STEAMGIFTS_BASE_URL="https://www.steamgifts.com"
HTTP_TIMEOUT_SECONDS=15.0
MIN_DELAY_SECONDS=3.0
MAX_DELAY_SECONDS=8.0
MAX_ENTRIES_PER_RUN=25
CATEGORY_DELAY_SECONDS=5.0

# Alertas de Telegram (Límite de puntos alcanzado)
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_POINTS_THRESHOLD=400

# Chequeo Automático de Puntos
AUTOCHECK_ENABLED=true
AUTOCHECK_MIN_INTERVAL=60
AUTOCHECK_MAX_INTERVAL=120
AUTOCHECK_NIGHT_START=1
AUTOCHECK_NIGHT_END=9

# Auto-Ejecución del Bot por Puntos
AUTOCHECK_AUTORUN_ENABLED=true
AUTOCHECK_AUTORUN_MIN_POINTS=380

# Prioridad y Orden de Categorías
CATEGORIES_ORDER="wishlist,dlc,group,Multiple Copies,recommended,new,all"

